  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameJam.UI.TitleScreen
  gameTitle: KILL OR DEAD
  briefing: "\uB3C4\uC2DC \uC678\uACFD, \uD3D0\uC1C4\uB41C \uC138\uC778\uD2B8 \uB9E4\uB85C\uC6B0
    \uBCD1\uC6D0.\n\uAC31\uB2E8\uC774 \uC774\uACF3\uC5D0\uC11C \uBD88\uBC95 \uC7A5\uAE30\uC801\uCD9C\uC744
    \uBC8C\uC774\uACE0, \uC801\uCD9C\uD55C \uC7A5\uAE30\uB97C \uC5B4\uB518\uAC00\uB85C
    \uD314\uC544\uB118\uAE30\uACE0 \uC788\uB2E4.\n\n\uC774 \uAC70\uB798\uC758 \uBC30\uD6C4\uAC00
    \uB204\uAD6C\uC778\uC9C0 \uBC1D\uD600\uB0BC \uB2E8\uC11C\uB294 \uB2E8 \uD558\uB098
    \u2014 \uADF8\uB4E4\uC758 \uC7A5\uBD80\uB2E4.\n\n\u2022 \uB9C8\uC744\uC744 \uC9C0\uB098
    \uBCD1\uC6D0 \uC815\uBB38\uC73C\uB85C \uC7A0\uC785\uD558\uB77C\n\u2022 2\uCE35
    \uC5B4\uB518\uAC00\uC758 \uC5F4\uC1E0\uCE74\uB4DC\uB85C \uC9C0\uD558 \uC2DC\uCCB4\uC548\uCE58\uC18C\uB97C
    \uC5F4\uACE0 \uC7A5\uBD80\uB97C \uD68C\uC218\uD558\uB77C\n\u2022 \uC7A5\uBD80\uB97C
    \uAC00\uC9C0\uACE0 \uD0C0\uACE0 \uC628 \uCC28\uB85C \uB3CC\uC544\uC624\uBA74
    \uC784\uBB34 \uC644\uB8CC\n\n\uB4E4\uD0A4\uBA74 \uADFC\uCC98\uC758 \uC801\uC774
    \uBAA8\uB450 \uBAB0\uB824\uC628\uB2E4. \uC870\uC6A9\uD788, \uBE60\uB974\uAC8C."
